@{
    ViewData["Title"] = "MyFinance - Plano de Contas";
}

<h1>Plano de Contas</h1>
<p><button type="button" class="btn btn-block btn-primary" onclick="Novo()">Criar item de Plano de Conta</button></p>

<p>
<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Descrição</th>
        <th>Tipo</th>
        <th>#</th>
        <th>#</th>
    </tr>

    @{
        foreach (PlanoContaModel item in (List<PlanoContaModel>)ViewBag.ListaPlanoConta)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Descricao</td>
                <td>@item.Tipo</td>
                <td><button type="button" class="btn btn-block btn-outline-warning" onclick="Atualizar(@item.Id.ToString())">Editar</button></td>
                <td><button type="button" class="btn btn-block btn-outline-danger" onclick="Excluir(@item.Id.ToString())">Excluir</button></td>
            </tr>
        }
    }

</table>
</p>

<script>
    function Novo()
    {
        window.location.href = "../PlanoConta/Cadastrar";
    }

    function Atualizar(id)
    {
        window.location.href = "../PlanoConta/Cadastrar/" + id;
    }

    function Excluir(id)
    {
        window.location.href = "../PlanoConta/Excluir/" + id;
    }

</script>